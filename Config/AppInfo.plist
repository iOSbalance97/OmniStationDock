<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.omnistation.dock</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>omnistation</string>
			</array>
		</dict>
	</array>
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>minecraft</string>
		<string>roblox</string>
		<string>clashofclans</string>
		<string>clashroyale</string>
		<string>brawlstars</string>
		<string>hayday</string>
		<string>boombeach</string>
		<string>squadbusters</string>
		<string>fortnite</string>
		<string>pubgmobile</string>
		<string>codm</string>
		<string>yuanshengame</string>
		<string>pokemongo</string>
		<string>amongus</string>
		<string>asphalt9</string>
		<string>subwaysurfers</string>
		<string>candycrushsaga</string>
		<string>clashmini</string>
		<string>steamlink</string>
		<string>xbox</string>
		<string>stikjit</string>
		<string>stikdebug</string>
		<string>livecontainer</string>
		<string>armsx2</string>
		<string>melonx</string>
		<string>sidestore</string>
		<string>altstore</string>
	</array>
	<!-- Modo Juego de iOS (como MeloNX y ARMSX2): menos tareas de fondo y menos latencia del mando. -->
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.games</string>
	<key>LSSupportsGameMode</key>
	<true/>
	<key>GCSupportsGameMode</key>
	<true/>
	<key>GCSupportsControllerUserInteraction</key>
	<true/>
	<key>GCSupportedGameControllers</key>
	<array>
		<dict>
			<key>ProfileName</key>
			<string>ExtendedGamepad</string>
		</dict>
	</array>
	<!-- Tele por AirPlay o HDMI: la escena de la pantalla externa es de OSExternalDisplay (en una app
	     de SwiftUI, sin esto el sistema solo duplica la pantalla del iPhone). -->
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<true/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleExternalDisplayNonInteractive</key>
			<array>
				<dict>
					<key>UISceneConfigurationName</key>
					<string>OmniStation TV</string>
					<key>UISceneDelegateClassName</key>
					<string>OSExternalDisplaySceneDelegate</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
</dict>
</plist>

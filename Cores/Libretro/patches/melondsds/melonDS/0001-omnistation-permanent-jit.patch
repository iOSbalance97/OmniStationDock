diff --git a/src/ARMJIT_Global.cpp b/src/ARMJIT_Global.cpp
index e4aa42f..1d3fba4 100644
--- a/src/ARMJIT_Global.cpp
+++ b/src/ARMJIT_Global.cpp
@@ -42,6 +42,44 @@ u8* GetAlignedCodeMemoryStart()
 
 int RefCounter = 0;
 
+static CodeMemoryAlloc ProviderAlloc = nullptr;
+static CodeMemoryFree ProviderFree = nullptr;
+
+void SetCodeMemoryProvider(CodeMemoryAlloc alloc, CodeMemoryFree release)
+{
+    std::lock_guard guard(globalMutex);
+    ProviderAlloc = alloc;
+    ProviderFree = release;
+}
+
+bool HasCodeMemoryProvider()
+{
+    std::lock_guard guard(globalMutex);
+    return ProviderAlloc != nullptr;
+}
+
+void* AllocateCodeMemDualMapped(void** rw)
+{
+    std::lock_guard guard(globalMutex);
+    *rw = nullptr;
+    if (!ProviderAlloc)
+        return nullptr;
+    void* rx = ProviderAlloc(CodeMemorySliceSize, rw);
+    if (!rx || !*rw)
+    {
+        *rw = nullptr;
+        return nullptr;
+    }
+    return rx;
+}
+
+void FreeCodeMemDualMapped(void* rx)
+{
+    std::lock_guard guard(globalMutex);
+    if (ProviderFree && rx)
+        ProviderFree(rx);
+}
+
 void* AllocateCodeMem()
 {
     std::lock_guard guard(globalMutex);
diff --git a/src/ARMJIT_Global.h b/src/ARMJIT_Global.h
index 6cc06b2..098a7cb 100644
--- a/src/ARMJIT_Global.h
+++ b/src/ARMJIT_Global.h
@@ -37,6 +37,16 @@ void DeInit();
 void* AllocateCodeMem();
 void FreeCodeMem(void* codeMem);
 
+// OmniStation: executable memory from the host (iOS 26+ permanent JIT region). One region seen
+// twice: RX to run it, RW to write it. When set, the JIT takes its code memory from it.
+using CodeMemoryAlloc = void* (*)(size_t size, void** rw);
+using CodeMemoryFree = void (*)(void* rx);
+void SetCodeMemoryProvider(CodeMemoryAlloc alloc, CodeMemoryFree release);
+bool HasCodeMemoryProvider();
+// RX pointer (and *rw), or nullptr if there is no provider or it has no room.
+void* AllocateCodeMemDualMapped(void** rw);
+void FreeCodeMemDualMapped(void* rx);
+
 }
 
 }

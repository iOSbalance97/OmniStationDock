diff --git a/Makefile.libretro b/Makefile.libretro
index cd53109..75b52d8 100644
--- a/Makefile.libretro
+++ b/Makefile.libretro
@@ -228,7 +228,13 @@ endif
 ifeq ($(platform),ios-arm64)
 	ARCH := arm64
 	BUILTIN_GPU = neon
+ifeq ($(OMNI_EXEC_MEM),1)
+	# OmniStation: dynarec with the frontend's permanent JIT region (dual-mapped).
+	DYNAREC = ari64

diff --git a/core/linux/posix_vmem.cpp b/core/linux/posix_vmem.cpp
index 2d42410..7e3d76b 100644
--- a/core/linux/posix_vmem.cpp
+++ b/core/linux/posix_vmem.cpp
@@ -286,6 +286,53 @@ void release_jit_block(void *code_area, size_t size)
 	munmap(code_area, size);
 }
 
+#if defined(TARGET_IPHONE) && defined(OMNI_EXEC_MEM)
+} // namespace virtmem
+
+// OmniStation: executable memory from the frontend (RETRO_ENVIRONMENT_EXEC_MEM_ALLOC, as libretro's
+// Dolphin uses it on iOS). On iOS 26+ (TXM) the frontend keeps one region that a debugger prepared
+// once, in two views (RW and RX), so the JIT keeps working without a debugger.
+#define OMNI_ENVIRONMENT_EXEC_MEM_ALLOC 83
+#define OMNI_ENVIRONMENT_EXEC_MEM_FREE 84
+#define OMNI_EXEC_MEM_MODE_DUAL_MAP 4
+struct OmniExecMemAlloc { unsigned version; size_t size; unsigned mode; void *rx; void *rw; };
+struct OmniExecMemFree { void *rx; };
+extern bool (*environ_cb)(unsigned cmd, void *data); // shell/libretro/libretro.cpp
+
+bool omni_exec_mem_ready()
+{
+	OmniExecMemAlloc probe = { 1, 0, 0, nullptr, nullptr };
+	return environ_cb != nullptr && environ_cb(OMNI_ENVIRONMENT_EXEC_MEM_ALLOC, &probe)
+			&& probe.mode == OMNI_EXEC_MEM_MODE_DUAL_MAP;
+}
+
+namespace virtmem
+{
+
+bool prepare_jit_block(void *code_area, size_t size, void **code_area_rw, ptrdiff_t *rx_offset)
+{
+	// Version 1: the frontend takes back whatever is left at the end of each game.
+	OmniExecMemAlloc request = { 1, size, OMNI_EXEC_MEM_MODE_DUAL_MAP, nullptr, nullptr };
+	if (environ_cb == nullptr || !environ_cb(OMNI_ENVIRONMENT_EXEC_MEM_ALLOC, &request)
+			|| request.mode != OMNI_EXEC_MEM_MODE_DUAL_MAP || request.rx == nullptr || request.rw == nullptr)
+	{
+		ERROR_LOG(DYNAREC, "OmniStation: no executable memory from the frontend (%zu bytes)", size);
+		return false;
+	}
+	*code_area_rw = request.rw;
+	*rx_offset = (char *)request.rx - (char *)request.rw;
+	NOTICE_LOG(DYNAREC, "OmniStation: JIT with dual-mapped executable memory from the frontend, rx %p rw %p", request.rx, request.rw);
+	return true;
+}
+
+void release_jit_block(void *code_area1, void *code_area2, size_t size)
+{
+	// Callers pass the views in either order (or a null static one): the frontend takes RX or RW.
+	OmniExecMemFree request = { code_area2 != nullptr ? code_area2 : code_area1 };
+	if (environ_cb != nullptr && request.rx != nullptr)
+		environ_cb(OMNI_ENVIRONMENT_EXEC_MEM_FREE, &request);
+}
+#else
 // Use two addr spaces: need to remap something twice, therefore use allocate_shared_filemem()
 bool prepare_jit_block(void *code_area, size_t size, void **code_area_rw, ptrdiff_t *rx_offset)
 {
@@ -322,6 +369,7 @@ void release_jit_block(void *code_area1, void *code_area2, size_t size)
 	// keep code_area1 (RX) mapped since it's statically allocated
 	munmap(code_area2, size);
 }
+#endif // TARGET_IPHONE && OMNI_EXEC_MEM
 
 } // namespace virtmem
 

diff --git a/libretro/libretro.c b/libretro/libretro.c
index 4a9f129..bbea645 100644
--- a/libretro/libretro.c
+++ b/libretro/libretro.c
@@ -110,6 +110,42 @@ retro_audio_sample_batch_t audio_batch_cb = NULL;
 retro_environment_t environ_cb = NULL;
 retro_environment_t environ_clear_thread_waits_cb = NULL;
 
+#ifdef OMNI_EXEC_MEM
+/* OmniStation: executable memory from the frontend (RETRO_ENVIRONMENT_EXEC_MEM_ALLOC, as libretro's
+ * Dolphin uses it on iOS). On iOS 26+ (TXM) the frontend keeps one region that a debugger prepared
+ * once, in two views (RW and RX), so the dynarec keeps working without a debugger. */
+#define OMNI_ENVIRONMENT_EXEC_MEM_ALLOC 83
+#define OMNI_ENVIRONMENT_EXEC_MEM_FREE 84
+#define OMNI_EXEC_MEM_MODE_DUAL_MAP 4
+struct omni_exec_mem_alloc { unsigned version; size_t size; unsigned mode; void *rx; void *rw; };
+struct omni_exec_mem_free { void *rx; };
+
+int omni_exec_mem_ready(void)
+{
+   struct omni_exec_mem_alloc probe = { 1, 0, 0, NULL, NULL };
+   return environ_cb && environ_cb(OMNI_ENVIRONMENT_EXEC_MEM_ALLOC, &probe) &&
+          probe.mode == OMNI_EXEC_MEM_MODE_DUAL_MAP;
+}
+
+void *omni_exec_mem_alloc(size_t size, void **rw)
+{
+   struct omni_exec_mem_alloc request = { 1, size, OMNI_EXEC_MEM_MODE_DUAL_MAP, NULL, NULL };
+   *rw = NULL;
+   if (!environ_cb || !environ_cb(OMNI_ENVIRONMENT_EXEC_MEM_ALLOC, &request) ||
+       request.mode != OMNI_EXEC_MEM_MODE_DUAL_MAP || !request.rx || !request.rw)
+      return NULL;
+   *rw = request.rw;
+   return request.rx;
+}
+
+void omni_exec_mem_free(void *rx)
+{
+   struct omni_exec_mem_free request = { rx };
+   if (environ_cb && rx)
+      environ_cb(OMNI_ENVIRONMENT_EXEC_MEM_FREE, &request);
+}
+#endif
+
 struct retro_rumble_interface rumble;
 
 save_memory_data saved_memory;
@@ -1002,7 +1038,12 @@ static void update_variables(bool startup)
        
 #ifdef IOS
        bool can_jit = false;
+#ifdef OMNI_EXEC_MEM
+       /* OmniStation: ParaLLEl RSP's JIT (GNU lightning) writes and runs the same pages: never here. */
+       if (true)
+#else
        if (!environ_cb(RETRO_ENVIRONMENT_GET_JIT_CAPABLE, &can_jit) || !can_jit)
+#endif
        {
           if(current_rsp_type == RSP_PLUGIN_PARALLEL)
           {
@@ -1401,6 +1442,15 @@ static void update_variables(bool startup)
           else if (!strcmp(var.value, "dynamic_recompiler"))
              r4300_emumode = EMUMODE_DYNAREC;
        }
+#ifdef OMNI_EXEC_MEM
+       /* the dynarec only with executable memory from the frontend */
+       if (r4300_emumode == EMUMODE_DYNAREC && !omni_exec_mem_ready())
+       {
+          r4300_emumode = EMUMODE_INTERPRETER;
+          if (log_cb)
+             log_cb(RETRO_LOG_INFO, "OmniStation: no executable memory from the frontend, cached interpreter\n");
+       }
+#endif
 
        var.key = CORE_NAME "-aspect";
        var.value = NULL;

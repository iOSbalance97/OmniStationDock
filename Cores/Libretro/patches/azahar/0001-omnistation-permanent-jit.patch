+// prepared, as two views of the same pages (RX to run, RW to write). When these hooks are set,
+// every CodeBlock comes from them. alloc returns the RX view and stores the RW view in *rw.
+struct DualMapHooks {
+    void* (*alloc)(std::size_t size, void** rw) = nullptr;
+    void (*release)(void* rx) = nullptr;
+};
+
+inline DualMapHooks& dual_map_hooks()
+{
+    static DualMapHooks hooks;
+    return hooks;
+}
+#endif

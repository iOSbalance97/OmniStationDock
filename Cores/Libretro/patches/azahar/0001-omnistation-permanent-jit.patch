diff --git a/src/citra_libretro/environment.cpp b/src/citra_libretro/environment.cpp
index 01ffecf..fa57a23 100644
--- a/src/citra_libretro/environment.cpp
+++ b/src/citra_libretro/environment.cpp
@@ -16,6 +16,10 @@
 #include "streams/file_stream.h"
 #endif
 
+#ifdef IOS
+#include <oaknut/code_block.hpp>
+#endif
+
 using namespace LibRetro;
 
 namespace LibRetro {
@@ -232,6 +236,68 @@ bool CanUseJIT() {
     bool can_jit = false;
     return environ_cb(RETRO_ENVIRONMENT_GET_JIT_CAPABLE, &can_jit) && can_jit;
 }
+
+// OmniStation: JIT memory from the frontend (RETRO_ENVIRONMENT_EXEC_MEM_ALLOC, as libretro's
+// Dolphin uses it on iOS). On iOS 26+ (TXM) the frontend keeps one region that a debugger
+// prepared once, so the JIT keeps working after the debugger is gone.
+namespace {
+constexpr unsigned ENVIRONMENT_EXEC_MEM_ALLOC = 83;
+constexpr unsigned ENVIRONMENT_EXEC_MEM_FREE = 84;
+constexpr unsigned EXEC_MEM_MODE_UNAVAILABLE = 0;
+constexpr unsigned EXEC_MEM_MODE_UNRESTRICTED = 1;
+constexpr unsigned EXEC_MEM_MODE_DUAL_MAP = 4;
+
+struct ExecMemAlloc {
+    unsigned version;
+    size_t size;
+    unsigned mode;
+    void* rx;
+    void* rw;
+};
+
+struct ExecMemFree {
+    void* rx;
+};
+
+void* FrontendExecAlloc(std::size_t size, void** rw) {
+    ExecMemAlloc request{1, size, EXEC_MEM_MODE_DUAL_MAP, nullptr, nullptr};
+    if (!environ_cb || !environ_cb(ENVIRONMENT_EXEC_MEM_ALLOC, &request) ||
+        request.mode != EXEC_MEM_MODE_DUAL_MAP || request.rx == nullptr || request.rw == nullptr) {
+        *rw = nullptr;
+        return nullptr;
+    }
+    *rw = request.rw;
+    return request.rx;
+}
+
+void FrontendExecFree(void* rx) {
+    ExecMemFree request{rx};
+    if (environ_cb)
+        environ_cb(ENVIRONMENT_EXEC_MEM_FREE, &request);
+}
+} // namespace
+
+bool SetupJITMemory() {
+    auto& hooks = oaknut::dual_map_hooks();
+    ExecMemAlloc probe{1, 0, EXEC_MEM_MODE_UNAVAILABLE, nullptr, nullptr};
+    const bool answered = environ_cb && environ_cb(ENVIRONMENT_EXEC_MEM_ALLOC, &probe);
+    if (answered && probe.mode == EXEC_MEM_MODE_DUAL_MAP) {
+        hooks.alloc = FrontendExecAlloc;
+        hooks.release = FrontendExecFree;
+        LOG_INFO(Frontend, "JIT: dual-mapped executable memory from the frontend");
+        return true;
+    }
+    hooks.alloc = nullptr;
+    hooks.release = nullptr;
+    // Before TXM the debugger's JIT lets the core map its own memory. A frontend that answers
+    // "unavailable" means it: no JIT (mapping it here would fail under TXM).
+    if (answered ? probe.mode == EXEC_MEM_MODE_UNRESTRICTED : CanUseJIT()) {
+        LOG_INFO(Frontend, "JIT: the core maps its own executable memory");
+        return true;
+    }
+    LOG_WARNING(Frontend, "JIT: not available, using the interpreter");
+    return false;
+}
 #endif
 
 void OnConfigureEnvironment() {

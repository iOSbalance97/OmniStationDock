+/**
+ * OmniStation: read-only view of an NCCH whose encrypted parts are decrypted on the fly
+ * (AES-CTR with the console keys, as Citra did). Bytes outside the regions are plain.
+ */
+class NCCHDecryptIOFile : public IOFileBase {
+public:
+    struct Region {
+        u64 begin = 0;  ///< First byte (offset inside the NCCH)
+        u64 end = 0;    ///< One past the last byte
+        u64 origin = 0; ///< Offset where the CTR stream starts
+        std::vector<u8> key;
+        std::vector<u8> ctr;
+
+        template <class Archive>
+        void serialize(Archive& ar, const unsigned int) {
+            ar & begin;
+            ar & end;
+            ar & origin;
+            ar & key;
+            ar & ctr;
+        }
+    };
+
+    NCCHDecryptIOFile();
+    NCCHDecryptIOFile(std::unique_ptr<IOFileBase>&& child_file, std::vector<Region> regions);
+    ~NCCHDecryptIOFile() override;
+
+    std::unique_ptr<IOFileBase> OpenCopy() const override;
+    bool Resize(u64 size) override {
+        return false;
+    }
+
+protected:
+    std::size_t ReadImpl(void* data, std::size_t length, std::size_t elem_size) override;
+    std::size_t ReadAtImpl(void* data, std::size_t byte_count, std::size_t offset) override;
+    std::size_t WriteImpl(const void* data, std::size_t length, std::size_t elem_size) override {
+        return 0;
+    }
+    IOType::Type MyType() const override {
+        return IOType::Type::NCCHDecryptIOFile;
+    }
+
+private:
+    void Decrypt(u8* data, std::size_t size, u64 offset) const;
+
+    std::vector<Region> regions;
+
+    template <class Archive>
+    void serialize(Archive& ar, const unsigned int) {
+        ar& boost::serialization::base_object<IOFileBase>(*this);
+        ar & regions;
+    }
+    friend class boost::serialization::access;
+};
+

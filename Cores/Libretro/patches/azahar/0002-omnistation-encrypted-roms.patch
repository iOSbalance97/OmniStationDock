+NCCHDecryptIOFile::NCCHDecryptIOFile() {
+    Child() = std::make_unique<NullIOFile>();
+}
+
+NCCHDecryptIOFile::NCCHDecryptIOFile(std::unique_ptr<IOFileBase>&& child_file,
+                                     std::vector<Region> regions_)
+    : regions(std::move(regions_)) {
+    Child() = std::move(child_file);
+}
+
+NCCHDecryptIOFile::~NCCHDecryptIOFile() = default;
+
+std::unique_ptr<IOFileBase> NCCHDecryptIOFile::OpenCopy() const {
+    return std::make_unique<NCCHDecryptIOFile>(Child()->OpenCopy(), regions);
+}
+
+void NCCHDecryptIOFile::Decrypt(u8* data, std::size_t size, u64 offset) const {
+    if (size == 0) {
+        return;
+    }
+    const u64 last = offset + size;
+    for (const auto& region : regions) {
+        const u64 begin = std::max<u64>(offset, region.begin);
+        const u64 end = std::min<u64>(last, region.end);
+        if (begin >= end || region.key.size() != 16 || region.ctr.size() != 16) {
+            continue;
+        }
+        CryptoPP::CTR_Mode<CryptoPP::AES>::Decryption d(region.key.data(), region.key.size(),
+                                                        region.ctr.data());
+        d.Seek(begin - region.origin);
+        u8* ptr = data + (begin - offset);
+        d.ProcessData(ptr, ptr, static_cast<std::size_t>(end - begin));
+    }
+}
+
+std::size_t NCCHDecryptIOFile::ReadImpl(void* data, std::size_t length, std::size_t elem_size) {
+    const u64 position = Tell();
+    const std::size_t items = IOFileBase::ReadImpl(data, length, elem_size);
+    Decrypt(static_cast<u8*>(data), items * elem_size, position);
+    return items;
+}
+
+std::size_t NCCHDecryptIOFile::ReadAtImpl(void* data, std::size_t byte_count, std::size_t offset) {
+    const std::size_t bytes = IOFileBase::ReadAtImpl(data, byte_count, offset);
+    Decrypt(static_cast<u8*>(data), bytes, offset);
+    return bytes;
+}
+

+/**
+ * OmniStation: encrypted NCCH support, as Citra had it (keys from the user's aes_keys.txt or
+ * keys.txt, seeds from seeddb.bin). Replaces `file` by a view that decrypts on the fly.
+ * Returns Success when `file` can now be read as a decrypted NCCH.
+ */
+static Loader::ResultStatus OpenDecryptedNCCH(std::unique_ptr<FileUtil::IOFileBase>& file,
+                                              const NCCH_Header& ncch_header) {
+    using namespace HW::AES;
+
+    // Some tools decrypt the NCCH but leave the flag: then the exheader reads as plain.
+    // This ID check is masked to low 32-bit as a toleration to ill-formed ROM created
+    // by merging games and its updates.
+    if (ncch_header.extended_header_size) {
+        ExHeader_Header raw_exheader;
+        if (file->ReadAtBytes(&raw_exheader, sizeof(raw_exheader), sizeof(NCCH_Header)) ==
+                sizeof(raw_exheader) &&
+            (raw_exheader.system_info.jump_id & 0xFFFFFFFF) ==
+                (ncch_header.program_id & 0xFFFFFFFF)) {
+            LOG_WARNING(Service_FS, "NCCH is marked as encrypted but with decrypted "
+                                    "exheader. Force no crypto scheme.");
+            return Loader::ResultStatus::Success;
+        }
+    }
+
+    // Keys: read again if the user folder changed (the libretro core sets it at load).
+    static std::string keys_folder;
+    const std::string sysdata = FileUtil::GetUserPath(FileUtil::UserPath::SysDataDir);
+    InitKeys(keys_folder != sysdata);
+    keys_folder = sysdata;
+
+    AESKey primary_key{};
+    AESKey secondary_key{};
+    bool failed_to_decrypt = false;
+
+    if (ncch_header.fixed_key) {
+        LOG_DEBUG(Service_FS, "Fixed-key crypto");
+    } else {
+        AESKey key_y_primary;
+        AESKey key_y_secondary;
+        std::copy(ncch_header.signature, ncch_header.signature + key_y_primary.size(),
+                  key_y_primary.begin());
+
+        if (!ncch_header.seed_crypto) {
+            key_y_secondary = key_y_primary;
+        } else {
+            auto opt{FileSys::GetSeed(ncch_header.program_id)};
+            if (!opt.has_value()) {
+                LOG_ERROR(Service_FS, "Seed for program {:016X} not found",
+                          ncch_header.program_id);
+                failed_to_decrypt = true;
+            } else {
+                auto seed{*opt};
+                std::array<u8, 32> input;
+                std::memcpy(input.data(), key_y_primary.data(), key_y_primary.size());
+                std::memcpy(input.data() + key_y_primary.size(), seed.data(), seed.size());
+                CryptoPP::SHA256 sha;
+                std::array<u8, CryptoPP::SHA256::DIGESTSIZE> hash;
+                sha.CalculateDigest(hash.data(), input.data(), input.size());
+                std::memcpy(key_y_secondary.data(), hash.data(), key_y_secondary.size());
+            }
+        }
+
+        SetKeyY(KeySlotID::NCCHSecure1, key_y_primary);
+        if (!IsNormalKeyAvailable(KeySlotID::NCCHSecure1)) {
+            LOG_ERROR(Service_FS, "Secure1 KeyX missing");
+            failed_to_decrypt = true;
+        }
+        primary_key = GetNormalKey(KeySlotID::NCCHSecure1);
+
+        std::size_t secondary_slot = KeySlotID::NCCHSecure1;
+        switch (ncch_header.secondary_key_slot) {
+        case 0:
+            secondary_slot = KeySlotID::NCCHSecure1;
+            break;
+        case 1:
+            secondary_slot = KeySlotID::NCCHSecure2;
+            break;
+        case 10:
+            secondary_slot = KeySlotID::NCCHSecure3;
+            break;
+        case 11:
+            secondary_slot = KeySlotID::NCCHSecure4;
+            break;
+        default:
+            LOG_ERROR(Service_FS, "Unknown secondary key slot {}", ncch_header.secondary_key_slot);
+            failed_to_decrypt = true;
+            break;
+        }
+        SetKeyY(secondary_slot, key_y_secondary);
+        if (!IsNormalKeyAvailable(secondary_slot)) {
+            LOG_ERROR(Service_FS, "KeyX for slot {:#X} missing", secondary_slot);
+            failed_to_decrypt = true;
+        }
+        secondary_key = GetNormalKey(secondary_slot);
+    }
+
+    // Find CTR for each section
+    // Written with reference to
+    // https://github.com/d0k3/GodMode9/blob/99af6a73be48fa7872649aaa7456136da0df7938/arm9/source/game/ncch.c#L34-L52
+    std::array<u8, 16> exheader_ctr{};
+    std::array<u8, 16> exefs_ctr{};
+    std::array<u8, 16> romfs_ctr{};
+    if (ncch_header.version == 0 || ncch_header.version == 2) {
+        LOG_DEBUG(Loader, "NCCH version 0/2");
+        // In this version, CTR for each section is a magic number prefixed by partition ID
+        // (reverse order)
+        std::reverse_copy(ncch_header.partition_id, ncch_header.partition_id + 8,
+                          exheader_ctr.begin());
+        exefs_ctr = romfs_ctr = exheader_ctr;
+        exheader_ctr[8] = 1;
+        exefs_ctr[8] = 2;
+        romfs_ctr[8] = 3;
+    } else if (ncch_header.version == 1) {
+        LOG_DEBUG(Loader, "NCCH version 1");
+        // In this version, CTR for each section is the section offset prefixed by partition
+        // ID, as if the entire NCCH image is encrypted using a single CTR stream.
+        std::copy(ncch_header.partition_id, ncch_header.partition_id + 8, exheader_ctr.begin());
+        exefs_ctr = romfs_ctr = exheader_ctr;
+        auto u32ToBEArray = [](u32 value) -> std::array<u8, 4> {
+            return std::array<u8, 4>{
+                static_cast<u8>(value >> 24),
+                static_cast<u8>((value >> 16) & 0xFF),
+                static_cast<u8>((value >> 8) & 0xFF),
+                static_cast<u8>(value & 0xFF),
+            };
+        };
+        auto offset_exheader = u32ToBEArray(0x200); // exheader offset
+        auto offset_exefs = u32ToBEArray(ncch_header.exefs_offset * kBlockSize);
+        auto offset_romfs = u32ToBEArray(ncch_header.romfs_offset * kBlockSize);
+        std::copy(offset_exheader.begin(), offset_exheader.end(), exheader_ctr.begin() + 12);
+        std::copy(offset_exefs.begin(), offset_exefs.end(), exefs_ctr.begin() + 12);
+        std::copy(offset_romfs.begin(), offset_romfs.end(), romfs_ctr.begin() + 12);
+    } else {
+        LOG_ERROR(Service_FS, "Unknown NCCH version {}", ncch_header.version);
+        failed_to_decrypt = true;
+    }
+
+    if (failed_to_decrypt) {
+        LOG_ERROR(Service_FS, "Failed to decrypt (missing keys in aes_keys.txt / keys.txt?)");
+        return Loader::ResultStatus::ErrorEncrypted;
+    }
+
+    using Region = FileUtil::NCCHDecryptIOFile::Region;
+    const auto to_vector = [](const std::array<u8, 16>& array) {
+        return std::vector<u8>(array.begin(), array.end());
+    };
+    std::vector<Region> regions;
+
+    // Extended header (and access descriptor)
+    if (ncch_header.extended_header_size) {
+        regions.push_back({sizeof(NCCH_Header), sizeof(NCCH_Header) + sizeof(ExHeader_Header),
+                           sizeof(NCCH_Header), to_vector(primary_key), to_vector(exheader_ctr)});
+    }
+
+    // ExeFS: its header, icon and banner use the primary key; the rest the secondary one.
+    if (ncch_header.exefs_size) {
+        const u64 exefs_offset = static_cast<u64>(ncch_header.exefs_offset) * kBlockSize;
+        const u64 exefs_end = exefs_offset + static_cast<u64>(ncch_header.exefs_size) * kBlockSize;
+        ExeFs_Header exefs_header;
+        if (file->ReadAtBytes(&exefs_header, sizeof(exefs_header), exefs_offset) !=
+            sizeof(exefs_header)) {
+            return Loader::ResultStatus::Error;
+        }
+        CryptoPP::CTR_Mode<CryptoPP::AES>::Decryption(primary_key.data(), primary_key.size(),
+                                                      exefs_ctr.data())
+            .ProcessData(reinterpret_cast<CryptoPP::byte*>(&exefs_header),
+                         reinterpret_cast<CryptoPP::byte*>(&exefs_header), sizeof(exefs_header));
+        regions.push_back({exefs_offset, exefs_offset + sizeof(ExeFs_Header), exefs_offset,
+                           to_vector(primary_key), to_vector(exefs_ctr)});
+        for (const auto& section : exefs_header.section) {
+            if (section.name[0] == '\0' || section.size == 0) {
+                continue;
+            }
+            const u64 begin = exefs_offset + sizeof(ExeFs_Header) + section.offset;
+            const u64 end = std::min<u64>(begin + section.size, exefs_end);
+            if (begin >= end) {
+                continue;
+            }
+            const bool primary = std::strncmp(section.name, "icon", 8) == 0 ||
+                                 std::strncmp(section.name, "banner", 8) == 0;
+            regions.push_back({begin, end, exefs_offset,
+                               to_vector(primary ? primary_key : secondary_key),
+                               to_vector(exefs_ctr)});
+        }
+    }
+
+    // RomFS
+    if (ncch_header.romfs_offset != 0 && ncch_header.romfs_size != 0) {
+        const u64 romfs_offset = static_cast<u64>(ncch_header.romfs_offset) * kBlockSize;
+        const u64 romfs_end = romfs_offset + static_cast<u64>(ncch_header.romfs_size) * kBlockSize;
+        regions.push_back({romfs_offset, romfs_end, romfs_offset, to_vector(secondary_key),
+                           to_vector(romfs_ctr)});
+    }
+
+    LOG_INFO(Service_FS, "Encrypted NCCH: decrypting on the fly ({} regions)", regions.size());
+    file = std::make_unique<FileUtil::NCCHDecryptIOFile>(std::move(file), std::move(regions));
+    return Loader::ResultStatus::Success;
+}

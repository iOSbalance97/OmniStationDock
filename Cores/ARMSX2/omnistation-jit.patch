--- a/common/Darwin/DarwinMisc.cpp
+++ b/common/Darwin/DarwinMisc.cpp
@@ -597,6 +597,27 @@ size_t DarwinMisc::g_code_rw_size = 0;
 // cancellation does not wait for an event handler which is already running.
 static std::mutex s_jit_validation_mutex;
 
+// [OmniStation] Code memory handed out by the host app (see SetCodeMemoryProvider).
+static DarwinMisc::CodeMemoryAlloc s_code_provider_alloc = nullptr;
+static DarwinMisc::CodeMemoryFree s_code_provider_free = nullptr;
+static void* s_code_provider_block = nullptr;
+
+void DarwinMisc::SetCodeMemoryProvider(CodeMemoryAlloc alloc, CodeMemoryFree release)
+{
+	s_code_provider_alloc = alloc;
+	s_code_provider_free = release;
+}
+
+bool DarwinMisc::HasCodeMemoryProvider()
+{
+	return s_code_provider_alloc != nullptr;
+}
+
+bool DarwinMisc::CodeMemoryFromProvider()
+{
+	return s_code_provider_block != nullptr;
+}
+
 void DarwinMisc::SetCrashLogFD(int fd)
 {

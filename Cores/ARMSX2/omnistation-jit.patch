 	u32 cs_flags = 0;
 	const int rv = csops(getpid(), 0, &cs_flags, sizeof(cs_flags));
-	const bool cs_debugged = (rv == 0) && ((cs_flags & 0x10000000u) != 0);
+	const bool cs_debugged = s_code_provider_block != nullptr ||
+	                         ((rv == 0) && ((cs_flags & 0x10000000u) != 0));
 	if (!cs_debugged)
 	{
 		std::fprintf(stderr, "@@JIT_KEEPALIVE@@ alive=0 reason=cs_debugged_revoked\n");
@@ -976,6 +1008,29 @@ void* DarwinMisc::MmapCodeDualMap(size_t size)
 	std::fflush(stderr);
 	return ptr;
 #else
+	if (s_code_provider_alloc)
+	{
+		void* rw_ptr = nullptr;
+		void* rx_ptr = s_code_provider_alloc(size, &rw_ptr);
+		if (rx_ptr && rw_ptr)
+		{
+			{
+				std::lock_guard<std::mutex> validation_lock(s_jit_validation_mutex);
+				g_code_rw_offset = static_cast<u8*>(rw_ptr) - static_cast<u8*>(rx_ptr);
+				g_code_rw_base = reinterpret_cast<uintptr_t>(rw_ptr);
+				g_code_rw_size = size;
+				s_code_provider_block = rx_ptr;
+			}
+			s_jit_mode = JitMode::LuckTXM;
+			s_jit_mode_detected = true;
+			std::fprintf(stderr, "@@JIT_ALLOC@@ host_code_memory_ok rx=%p rw=%p size=0x%zx\n", rx_ptr, rw_ptr, size);
+			std::fflush(stderr);
+			return rx_ptr;
+		}
+		std::fprintf(stderr, "@@JIT_ALLOC@@ host_code_memory_fail size=0x%zx\n", size);
+		std::fflush(stderr);

 bool DarwinMisc::ValidateJITAlive()
 {
 #if TARGET_OS_IPHONE && !TARGET_OS_SIMULATOR
-	// Check 1: CS_DEBUGGED still set?
+	// Check 1: CS_DEBUGGED still set? (Not needed for host memory: the region is already

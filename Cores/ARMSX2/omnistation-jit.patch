@@ -678,6 +699,15 @@ bool DarwinMisc::IsJITAvailable()
 #if TARGET_OS_SIMULATOR
 	return true;
 #elif TARGET_OS_IPHONE
+	if (s_code_provider_alloc)
+	{
+		// The host already holds a prepared region: dual-mapped JIT, no debugger needed.
+		s_jit_mode = JitMode::LuckTXM;
+		s_jit_mode_detected = true;
+		std::fprintf(stderr, "@@JIT_DETECT@@ result=AVAILABLE reason=host_code_memory\n");

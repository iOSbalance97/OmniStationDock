@@ -1112,6 +1167,23 @@ void DarwinMisc::MunmapCodeDualMap(void* rx_ptr, size_t size)
 	// Wait for any already-running idle validation before invalidating either
 	// the RW alias or executable mapping.
 	std::lock_guard<std::mutex> validation_lock(s_jit_validation_mutex);
+	if (rx_ptr && rx_ptr == s_code_provider_block)
+	{
+		// Host memory goes back to the host (its region stays prepared for the next game).
+		g_code_rw_offset = 0;
+		g_code_rw_base = 0;
+		g_code_rw_size = 0;
+		s_code_provider_block = nullptr;
+		if (s_code_provider_free)
+			s_code_provider_free(rx_ptr);
+#if TARGET_OS_IPHONE
+		s_legacy_code_base = nullptr;
+		s_legacy_code_size = 0;
+		s_legacy_is_writable = true;
+		s_legacy_range_log_done = false;
+#endif
+		return;
+	}
 	const uintptr_t rw_base = g_code_rw_base;
 	const size_t rw_size = g_code_rw_size;
 	const ptrdiff_t rw_offset = g_code_rw_offset;
diff --git a/common/Darwin/DarwinMisc.h b/common/Darwin/DarwinMisc.h
index 47a0284..9e4a809 100644
--- a/common/Darwin/DarwinMisc.h
+++ b/common/Darwin/DarwinMisc.h
@@ -145,6 +145,16 @@ struct CPUClass {
     // Free dual-mapped code memory
     void MunmapCodeDualMap(void* rx_ptr, size_t size);
 
+    // [OmniStation] Executable memory from the host app: one region that a debugger already
+    // prepared (RX), with its RW view. When set, MmapCodeDualMap takes the code memory from it
+    // and the JIT keeps working without a debugger. alloc returns RX and stores RW in *rw.
+    using CodeMemoryAlloc = void* (*)(size_t size, void** rw);
+    using CodeMemoryFree = void (*)(void* rx);
+    void SetCodeMemoryProvider(CodeMemoryAlloc alloc, CodeMemoryFree release);
+    bool HasCodeMemoryProvider();
+    // The current code memory came from the host (no debugger needed for it).
+    bool CodeMemoryFromProvider();
+
     // [P49] Legacy lazy toggle: flip RW→RX + icache flush before JIT dispatch.
     // Call this once before entering JIT code (e.g., in recExecute dispatcher).
     // No-op on non-Legacy modes.
